{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "v-synth-studio",
  "identifier": "com.qingmu.vocalworkstation",
  "build": {
    "beforeDevCommand": "pnpm prepare:assets dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare:assets && pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "V-Synth-Studio",
        "visible": false,
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: ws://localhost:1420 http://localhost:1420",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../data/resources.json": "data/resources.json",
      "../data/pinyin.json": "data/pinyin.json",
      "../tools": "tools"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "80f95787-88be-52d0-8519-c551ce0418d9"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh",
        "languages": ["SimpChinese", "English", "Japanese"],
        "customLanguageFiles": {
          "SimpChinese": "./installer-zh-CN.nsh",
          "Japanese": "./installer-ja-JP.nsh"
        },
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": ["ffmpeg"]
      }
    },
    "shortDescription": "翻调 P 主的本地工作台",
    "longDescription": "工程格式互转、MV 解析下载、人声分离、资源导航。完全离线运行。工具随包分发，不需要联网下载（Linux 例外：ffmpeg 来自系统仓库，deb 的 Depends 在安装时自动带上）。"
  }
}
