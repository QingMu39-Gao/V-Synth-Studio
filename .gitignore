# ═══════════════════════════════════════════════════════════
#  V-Synth-Studio —— 忽略规则
#
#  原则：**仓库只放源码**（约 7 MB）。凡是不属于源码、但编译/打包时
#  需要的大二进制，都由 app\desktop\fetch-tools.ps1 在编译前补齐，
#  一律不入库。下面每一条大件忽略规则都写清了补齐方式。
# ═══════════════════════════════════════════════════════════

# ── 上传 Release 用的大存档（本地产物，不入库）──────────────
# 由 tools\zip-assets.ps1 打出来，内容是 tools\ 与 app\web\vendor\jizura\。
# 传上 GitHub Release 后，fetch-tools.ps1 就能在干净机器上把两块补齐。
/资料归档/

# ── 运行时数据 ──────────────────────────────────────────────
# 注意前面的斜杠：data/ 会匹配任意层级的 data 目录，那样会连
# app/data/（资源库、拼音词典）一起排除掉，程序会缺功能。
# 这几个目录只在仓库根目录，所以必须用 / 锚定。
/data/
/downloads/

# ── 外部工具（体积大，编译前补齐，不进仓库）─────────────────
# tools/ 里是 ffmpeg（约 200MB）、yt-dlp、LibreSVIP CLI（约 70MB），合计约 288MB。
# 补齐方式：powershell -ExecutionPolicy Bypass -File app\desktop\fetch-tools.ps1
# 仓库只放源码 —— 这几样是官方二进制，放进 git 只会让每次 clone 都拖几百 MB。
#
# ⚠️ 这三行必须**按这个顺序**写，别合并成一句 /tools/：
#     git 不会进入被排除的目录，所以「排除 tools\ 再单独放行里面的脚本」是无效的
#     （!/tools/*.ps1 永远匹配不上，因为 git 压根没往里走）。
#     正确写法是先让 tools/ 本身不被排除，再逐层排除里面的东西。
#     效果：仓库里只有 tools\*.ps1 这几个脚本，下面的二进制全都不进。
/tools/*
!/tools/*.ps1

# ── 本机配置 ────────────────────────────────────────────────
# 含个人路径（输出目录、下载目录）。程序首次运行会自动按默认值生成。
app/data/config.json

# ── 依赖与构建产物 ──────────────────────────────────────────
node_modules/
*.exe
*.dll
*.pdb
*.obj

# ── Rust / Tauri 构建产物 ───────────────────────────────────
# target/ 是编译中间产物，轻松上 GB，绝对不进仓库。
# 源码在 app/desktop/{Cargo.toml,tauri.conf.json,build.rs,src/,icons/,dist/}。
# 图标（icons/）和起始页（dist/）是源码的一部分，要入库 —— 所以只忽略 target。
app/desktop/target/
# gen/ 是 tauri-build 每次编译重写的 schema（capabilities / ACL / windows 三份），
# 一个字节都不是手写的。以前误当源码入了库，于是每次编译都制造一堆假改动。
app/desktop/gen/
# Cargo.lock 对可执行程序应当入库，锁定依赖版本以保证可复现构建
!app/desktop/Cargo.lock

# ── 真实工程样本（版权原因不入库）───────────────────────────
# tests/samples/ 下这些是真实歌曲工程（白石溪、呐呐呐等）与用户自己的
# OpenUtau 备份，属于有版权的作品数据，不要随源码分发。
# 合成出来的 sample-* 夹具仍然入库。
tests/samples/real-sample-*
tests/samples/openutau-*

# ── 前端构建（app/web-next）────────────────────────────────
# Vite 的**产物**（app/web/：index.html + assets/，含带哈希的文件名）要入库 ——
# 后端运行时伺服它，属于「随包分发的东西」。⚠️ 别把它当成可再生成的构建垃圾忽略掉：
# 没有 assets/ 的话 fresh clone 打开就是白屏（index.html 引用的是哈希文件名）。
# 代价是每次前端构建都会改 index.html + 两个哈希文件，这是刻意的取舍。
# 但依赖与增量编译缓存不进库：
app/web-next/node_modules/
*.tsbuildinfo
# ∧ 补充（2026-10-05）：assets/ 里是**带内容哈希**的产物，`emptyOutDir:false`
# 让每次构建都往里加新文件、旧的也不会自动删。入库的话每构建一次就多两个永不
# 被引用的文件，且「旧版本」会在历史里越堆越多 —— 只保留 index.html 这一个
# 入口（它同时也是 resolve_paths() 判定程序根目录的哨兵）。
app/web/assets/

# ── JIZURA 字体（同上：大二进制，编译前补齐）────────────────
# app/web/vendor/jizura/ 是 JIZURA 文字 PV 的构建产物（index.html 2.3MB）+ 2335 个
# woff2 字体（49.4MB）+ fonts.css（2.5MB），合计约 54MB。PV 页的 iframe 指向
# /vendor/jizura/index.html，离线可用靠的就是它，所以**不能只留在网盘上**：
# 同样由 fetch-tools.ps1 在编译前补进 app\web\vendor\jizura\。
# ⚠️ 只忽略 jizura 这一层，别写成 app/web/vendor/ —— 以后要往里加别的东西时
# 不会被这条规则连坐。目录本身不在库里，fetch-tools.ps1 会自己建。
app/web/vendor/jizura/

# ── 探针输出（tests/manual/*.mjs 写的截图与 JSON）────────────
# 只是给人看的中间产物，不是夹具，不入库。
tests/manual/out/

# ── 临时与调试文件 ──────────────────────────────────────────
tmp-*/
_tmp-*
_diag-*
*.part
*.tmp
*.bak
*.log

# ── 编辑器 / 系统 ───────────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
