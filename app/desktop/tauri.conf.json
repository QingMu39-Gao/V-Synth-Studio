{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清沐的虚拟歌姬工作站",
  "version": "1.0.0",
  "identifier": "com.qingmu.vocalworkstation",

  "build": {
    "frontendDist": "./dist"
  },

  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],

    "resources": {
      "../../app/web": "app/web",
      "../../app/data/resources.json": "app/data/resources.json",
      "../../app/data/pinyin.json": "app/data/pinyin.json",
      "../../app/data/RESOURCES-README.md": "app/data/RESOURCES-README.md",
      "../../tools": "tools"
    },

    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "翻调 P 主的本地工作台",
    "longDescription": "工程格式互转、MV 解析下载、人声分离、资源导航。完全离线运行。工具（ffmpeg / yt-dlp / LibreSVIP）随包分发，不需要联网下载。"
  }
}
